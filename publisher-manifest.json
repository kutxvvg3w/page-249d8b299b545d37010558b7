em 1.2rem;border-radius: 10px;font-size: .85rem;font-weight: 600}\n.plan-btn.solid {background: #A6FF00;color: #050507}\n.plan-tag {display: inline-block;background: #A6FF00;color: #050507;font-size: .68rem;font-weight: 700;padding: .2rem .6rem;border-radius: 4px;letter-spacing: .1em;margin-left: .6rem;vertical-align: middle}\n\n/* Clients */\n.clients-grid {display: grid;grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));gap: 1.5rem}\n.client-card {background: #0E0E11;border-radius: 22px;padding: 2rem;box-shadow: 0 18px 40px -16px rgba(0,0,0,.7);border: 1px solid rgba(255,255,255,.04)}\n.client-card h3 {font-size: 1.3rem;margin-bottom: .8rem;color: #F2F2F2}\n.client-card p {color: #999;font-size: .92rem;line-height: 1.7;margin-bottom: 1.2rem}\n.client-meta {display: flex;flex-wrap: wrap;gap: .6rem}\n.client-tag {font-size: .72rem;padding: .35rem .7rem;border-radius: 999px;border: 1px solid rgba(255,255,255,.1);color: #B0B0B0}\n.client-link {display: inline-block;margin-top: 1rem;font-size: .85rem;color: #A6FF00;font-weight: 600}\n\n/* Usage */\n.usage-list {counter-reset: step;max-width: 760px}\n.usage-step {position: relative;padding: 2rem 0 2rem 3.5rem;border-bottom: 1px solid rgba(255,255,255,.05)}\n.usage-step::before {counter-increment: step;content: counter(step, decimal-leading-zero);position: absolute;left: 0;top: 2rem;font-size: 1.1rem;font-weight: 700;color: #A6FF00}\n.usage-step h3 {font-size: 1.1rem;margin-bottom: .5rem;color: #F2F2F2}\n.usage-step p {color: #999;font-size: .95rem}\n\n/* FAQ */\n.faq-wrap {background: #08080A;border-top: 1px solid rgba(255,255,255,.05);border-bottom: 1px solid rgba(255,255,255,.05);padding: 6rem 2rem}\n.faq-inner {max-width: 1200px;margin: 0 auto}\n.faq-grid {display: grid;grid-template-columns: 1fr 1fr;gap: 2.5rem 3rem}\n.faq-item h3 {font-size: 1.05rem;color: #F2F2F2;margin-bottom: .7rem;font-weight: 600}\n.faq-item p {color: #999;font-size: .92rem;line-height: 1.75}\n\n/* Footer */\nfooter {padding: 4rem 2rem 2rem;text-align: center}\n.footer-brand {font-size: 1.5rem;font-weight: 800;letter-spacing: -.01em;margin-bottom: .5rem}\n.footer-brand .accent {color: #A6FF00}\n.footer-text {color: #666;font-size: .85rem;max-width: 32rem;margin: 0 auto 2rem;line-height: 1.7}\n.footer-nav {display: flex;flex-wrap: wrap;justify-content: center;gap: 1rem;font-size: .85rem;margin-bottom: 2rem}\n.footer-nav a {color: #999;border-bottom: 1px solid transparent;padding-bottom: .1rem}\n.footer-nav a:hover {color: #A6FF00;border-color: #A6FF00}\n.footer-copy {color: #444;font-size: .78rem;border-top: 1px solid rgba(255,255,255,.05);padding-top: 1.5rem}\n\n@media (max-width: 860px) {\n  .hero {grid-template-columns: 1fr}\n  .hero-text {padding: 3.5rem 1.5rem;border-right: none;border-bottom: 1px solid rgba(166,255,0,.12)}\n  .hero-panel {padding: 2.5rem 1.5rem}\n  .section {padding: 4rem 1.5rem}\n  .plans-wrap, .faq-wrap {padding: 4rem 1.5rem}\n  .faq-grid {grid-template-columns: 1fr;gap: 2rem}\n  .status-grid {grid-template-columns: 1fr}\n}\n</style><header>\n  <nav class=\"nav-tags\">\n    <a href=\"#start\" class=\"nav-tag\">Horizon</a>\n    <a href=\"#principles\" class=\"nav-tag\">原则</a>\n    <a href=\"#plans\" class=\"nav-tag\">套餐</a>\n    <a href=\"#clients\" class=\"nav-tag\">客户端</a>\n    <a href=\"#usage\" class=\"nav-tag\">使用指南</a>\n    <a href=\"#faq\" class=\"nav-tag\">常见问题</a>\n  </nav>\n</header>\n\n<main>\n  <section class=\"hero\" id=\"start\">\n    <div class=\"hero-text\">\n      <span class=\"brand-mark\">越过边界 · 看见更多</span>\n      <h1>Horizon · 网络应有<span class=\"accent\">地平线</span>。<br>我们替你找到它。</h1>\n      <p class=\"hero-lede\">\n        Horizon 是一条克制的通道。墨黑为底，荧光绿为线。不喧哗，不越界。只把该看见的内容，稳稳送到你眼前。\n      </p>\n      <div class=\"hero-meta\">\n        <span>百千节点</span>\n        <span>原生流媒体</span>\n        <span>多端协同</span>\n        <span>隐私优先</span>\n      </div>\n    </div>\n    <div class=\"hero-panel\">\n      <span class=\"panel-label\">实时概览</span>\n      <div class=\"status-grid\">\n        <div class=\"status-cell\">\n          <div class=\"label\">核心节点</div>\n          <div class=\"value green\">126<span class=\"unit\">城</span></div>\n        </div>\n        <div class=\"status-cell\">\n          <div class=\"label\">在线设备</div>\n          <div class=\"value\">不限<span class=\"unit\">并发</span></div>\n        </div>\n        <div class=\"status-cell\">\n          <div class=\"label\">协议支持</div>\n          <div class=\"value\">Shadowsocks / Vmess / Trojan</div>\n        </div>\n        <div class=\"status-cell\">\n          <div class=\"label\">中继线路</div>\n          <div class=\"value green\">IPLC 专线</div>\n        </div>\n      </div>\n      <div class=\"cta-box\">\n        <div class=\"cta-title\">从基础版开始</div>\n        <div class=\"cta-sub\">每月 100GB，三台设备，¥15 起。</div>\n        <a href=\"#plans\" class=\"btn\">查看套餐 →</a>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"principles\">\n    <div class=\"section-head\">\n      <span class=\"section-eyebrow\">设计原则</span>\n      <h2>三条线，划定 Horizon 的边界。</h2>\n      <p class=\"section-sub\">不堆砌功能。不做多余承诺。每一项能力，都对应一个真实场景。</p>\n    </div>\n    <div class=\"principles\">\n      <article class=\"principle\">\n        <span class=\"num\">01 / 稳定</span>\n        <h3>线路优先，速度其次</h3>\n        <p>我们不在高峰时段追求极限带宽。我们追求的是晚上十点，你打开视频，它不卡。BGP 智能调度，IPLC 专线承载，延迟比峰值速率更重要。</p>\n      </article>\n      <article class=\"principle\">\n        <span class=\"num\">02 / 克制</span>\n        <h3>只做通道，不做生态</h3>\n        <p>Horizon 不内置浏览器，不捆绑清理工具，不推送资讯。它只做一件事：把你和数据之间那条路，铺平，压实，交给你。</p>\n      </article>\n      <article class=\"principle\">\n        <span class=\"num\">03 / 透明</span>\n        <h3>隐私是底线，不是卖点</h3>\n        <p>无日志策略，写在条款里。我们记录连接时长用于计费，不记录你访问了什么。账户可随时注销，数据即删。</p>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"plans-wrap\" id=\"plans\">\n    <div class=\"plans-inner\">\n      <div class=\"section-head\">\n        <span class=\"section-eyebrow\">套餐对比</span>\n        <h2>三档，对应三种使用强度。</h2>\n        <p class=\"section-sub\">按月灵活，按年更省。流量、设备数、节点池，逐项清晰。</p>\n      </div>\n      <table class=\"plans\">\n        <thead>\n          <tr>\n            <th>权益</th>\n            <th class=\"plan-name\">基础版</th>\n            <th class=\"plan-name featured\">旗舰版<span class=\"plan-tag\">推荐</span></th>\n            <th class=\"plan-name\">团队版</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td class=\"plan-feature\">月费</td>\n            <td><div class=\"plan-price\">¥15</div></td>\n            <td class=\"featured\"><div class=\"plan-price\">¥35</div></td>\n            <td><div class=\"plan-price\">¥85</div></td>\n          </tr>\n          <tr>\n            <td class=\"plan-feature\">年付优惠</td>\n            <td><span class=\"plan-price annual\">¥150 / 年</span></td>\n            <td class=\"featured\"><span class=\"plan-price annual\">¥350 / 年</span></td>\n            <td><span class=\"plan-price annual\">¥850 / 年</span></td>\n          </tr>\n          <tr>\n            <td class=\"plan-feature\">每月流量</td>\n            <td>100GB</td>\n            <td class=\"featured\">300GB</td>\n            <td>1000GB</td>\n          </tr>\n          <tr>\n            <td class=\"plan-feature\">同时在线设备</td>\n            <td>3 台</td>\n            <td class=\"featured\">5 台</td>\n            <td>20 台</td>\n          </tr>\n          <tr>\n            <td class=\"plan-feature\">流媒体解锁</td>\n            <td>基础区域</td>\n            <td class=\"featured\">全节点原生解锁</td>\n            <td>全节点原生解锁</td>\n          </tr>\n          <tr>\n            <td class=\"plan-feature\">线路类型</td>\n            <td>普通节点池</td>\n            <td class=\"featured\">IPLC 专线游戏优化</td>\n            <td>VIP 高带宽专属节点</td>\n          </tr>\n          <tr>\n            <td class=\"plan-feature\">企业定制路由</td>\n            <td>—</td>\n            <td class=\"featured\">—</td>\n            <td>支持</td>\n          </tr>\n          <tr>\n            <td class=\"plan-feature\">客服支持</td>\n            <td>标准工单</td>\n            <td class=\"featured\">7×24 优先工单</td>\n            <td>专属客户经理</td>\n          </tr>\n          <tr>\n            <td class=\"plan-feature plan-cell-buy\">订阅</td>\n            <td class=\"plan-cell-buy\"><a href=\"#\" class=\"plan-btn\">选择基础版</a></td>\n            <td class=\"featured plan-cell-buy\"><a href=\"#\" class=\"plan-btn solid\">选择旗舰版</a></td>\n            <td class=\"plan-cell-buy\"><a href=\"#\" class=\"plan-btn\">选择团队版</a></td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"clients\">\n    <div class=\"section-head\">\n      <span class=\"section-eyebrow\">客户端</span>\n      <h2>覆盖主流平台，配置极简。</h2>\n      <p class=\"section-sub\">扫码导入，一键切换节点。不收集设备信息，不要求多余权限。</p>\n    </div>\n    <div class=\"clients-grid\">\n      <article class=\"client-card\">\n        <h3>Windows</h3>\n        <p>支持 Windows 10 及以上。系统级代理，TUN 模式可选。开机自启，后台静默运行。</p>\n        <div class=\"client-meta\">\n          <span class=\"client-tag\">x64</span>\n          <span class=\"client-tag\">系统代理</span>\n          <span class=\"client-tag\">TUN 模式</span>\n        </div>\n        <a href=\"#\" class=\"client-link\">获取客户端 →</a>\n      </article>\n      <article class=\"client-card\">\n        <h3>macOS</h3>\n        <p>原生应用，适配 Apple Silicon 与 Intel 芯片。菜单栏快捷切换，支持分组管理节点。</p>\n        <div class=\"client-meta\">\n          <span class=\"client-tag\">Universal</span>\n          <span class=\"client-tag\">菜单栏</span>\n          <span class=\"client-tag\">分组</span>\n        </div>\n        <a href=\"#\" class=\"client-link\">获取客户端 →</a>\n      </article>\n      <article class=\"client-card\">\n        <h3>Android</h3>\n        <p>兼容 Android 7 及以上。分应用代理，可设定哪些 App 走通道，哪些走本地。</p>\n        <div class=\"client-meta\">\n          <span class=\"client-tag\">7.0+</span>\n          <span class=\"client-tag\">分应用代理</span>\n        </div>\n        <a href=\"#\" class=\"client-link\">获取客户端 →</a>\n      </article>\n      <article class=\"client-card\">\n        <h3>iOS</h3>\n        <p>App Store 提供。支持按需连接，锁屏后自动断开，节省电量与流量。</p>\n        <div class=\"client-meta\">\n          <span class=\"client-tag\">iOS 14+</span>\n          <span class=\"client-tag\">按需连接</span>\n        </div>\n        <a href=\"#\" class=\"client-link\">App Store →</a>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"section\" id=\"usage\">\n    <div class=\"section-head\">\n      <span class=\"section-eyebrow\">使用指南</span>\n      <h2>四步，从注册到连接。</h2>\n      <p class=\"section-sub\">不绕弯，不填表。拿到订阅链接，剩下的交给客户端。</p>\n    </div>\n    <ol class=\"usage-list\">\n      <li class=\"usage-step\">\n        <h3>选择套餐并注册</h3>\n        <p>在套餐页选择适合的档位。邮箱注册，不绑定手机号。支付完成即刻开通。</p>\n      </li>\n      <li class=\"usage-step\">\n        <h3>获取订阅链接</h3>\n        <p>登录用户中心，复制专属订阅地址。一个链接包含所有节点，无需手动添加。</p>\n      </li>\n      <li class=\"usage-step\">\n        <h3>导入客户端</h3>\n        <p>打开对应平台的 Horizon 客户端，粘贴链接。或直接扫描网页端二维码。节点列表自动同步。</p>\n      </li>\n      <li class=\"usage-step\">\n        <h3>连接并使用</h3>\n        <p>选择延迟最低的节点，点击连接。状态栏亮起荧光绿，即表示通道已建立。开始浏览。</p>\n      </li>\n    </ol>\n  </section>\n\n  <section class=\"faq-wrap\" id=\"faq\">\n    <div class=\"faq-inner\">\n      <div class=\"section-head\">\n        <span class=\"section-eyebrow\">常见问题</span>\n        <h2>关于 Horizon，你可能想问。</h2>\n        <p class=\"section-sub\">短问，短答。不绕弯子。</p>\n      </div>\n      <div class=\"faq-grid\">\n        <article class=\"faq-item\">\n          <h3>流量用完了会怎样？</h3>\n          <p>连接自动断开，不影响本地网络使用。可购买加油包，或等待下月重置。不会产生额外扣费。</p>\n        </article>\n        <article class=\"faq-item\">\n          <h3>可以随时更换套餐吗？</h3>\n          <p>可以。升级立即生效，按差价补款。降级在下个计费周期生效。不收手续费。</p>\n        </article>\n        <article class=\"faq-item\">\n          <h3>支持哪些流媒体平台？</h3>\n          <p>旗舰版及以上支持主流区域的原生解锁。具体平台列表会随地区策略调整，以客户端实际连接为准。</p>\n        </article>\n        <article class=\"faq-item\">\n          <h3>团队版的设备数怎么算？</h3>\n          <p>20 台设备可分配给不同子账户。管理员在后台统一管理流量、节点权限。适合小型团队或家庭共享。</p>\n        </article>\n        <article class=\"faq-item\">\n          <h3>有试用期或退款吗？</h3>\n          <p>不提供试用。订阅后 24 小内未产生实际流量（连接时长低于 10 分钟），可申请全额退款。超出则按已用周期折算。</p>\n        </article>\n        <article class=\"faq-item\">\n          <h3>节点列表多久更新一次？</h3>\n          <p>客户端每次启动会自动拉取最新节点。重大线路调整会在用户中心公告。无需手动更新软件。</p>\n        </article>\n        <article class=\"faq-item\">\n          <h3>会记录我的浏览历史吗？</h3>\n          <p>不会。我们仅记录连接起始时间与流量字节数，用于计费。连接断开后，这些数据不与具体网站关联。</p>\n        </article>\n        <article class=\"faq-item\">\n          <h3>支持自建节点接入吗？</h3>\n          <p>团队版支持企业定制路由，可接入自建中继节点。需联系客户经理单独配置。基础版与旗舰版不支持。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <div class=\"footer-brand\">Hori<span class=\"accent\">zon</span></div>\n  <p class=\"footer-text\">\n    Horizon 提供跨境网络连接服务。本页面内容仅作产品介绍，不构成任何法律或技术担保。使用前请确认当地法规。\n  </p>\n  <nav class=\"footer-nav\">\n    <a href=\"#start\">首页</a>\n    <a href=\"#principles\">原则</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#usage\">使用指南</a>\n    <a href=\"#faq\">常见问题</a>\n  </nav>\n  <p class=\"footer-copy\">© Horizon. 墨黑为底，荧光为线。</p>\n</footer>",
